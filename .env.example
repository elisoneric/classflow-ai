# Copy to .env and fill in real values. Never commit .env.
# On Coolify: paste these into the Environment Variables section of your resource.

# --- App ---
TIMEZONE=Africa/Lagos

# --- CORS ---
# Set to your Coolify-assigned domain, e.g. https://classflow.yourdomain.com
FRONTEND_ORIGIN=https://classflow.yourdomain.com

# --- Auth (JWT) ---
JWT_SECRET_KEY=changeme-generate-a-long-random-value

# --- Single Course Rep account (used by the seed script, not a public signup) ---
COURSE_REP_EMAIL=you@example.com
COURSE_REP_PASSWORD=changeme

# --- Outbound email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=changeme
SMTP_PASSWORD=changeme
SMTP_FROM_EMAIL=classflow@example.com
SMTP_USE_TLS=true

# --- Inbound email (IMAP polling) ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=changeme
IMAP_PASSWORD=changeme
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true
IMAP_POLL_INTERVAL_SECONDS=75

# --- AI (Gemini — active provider) ---
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-3.5-flash
AI_CONFIDENCE_THRESHOLD=0.75

# --- AI (Anthropic — alternate adapter, not wired in by default) ---
ANTHROPIC_API_KEY=changeme
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Copy to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
TIMEZONE=Africa/Lagos
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
POSTGRES_USER=classflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=classflow
DATABASE_URL=postgresql+asyncpg://classflow:changeme@postgres:5432/classflow

# --- Redis / RQ ---
REDIS_URL=redis://redis:6379/0

# --- Auth (JWT) ---
JWT_SECRET_KEY=changeme-generate-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Single Course Rep account (used by the seed script, not a public signup) ---
COURSE_REP_EMAIL=you@example.com
COURSE_REP_PASSWORD=changeme

# --- Outbound email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=changeme
SMTP_PASSWORD=changeme
SMTP_FROM_EMAIL=classflow@example.com
SMTP_USE_TLS=true

# --- Inbound email (IMAP polling) ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=changeme
IMAP_PASSWORD=changeme
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true
IMAP_POLL_INTERVAL_SECONDS=75

# --- AI (Anthropic) ---
ANTHROPIC_API_KEY=changeme
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_CONFIDENCE_THRESHOLD=0.75
